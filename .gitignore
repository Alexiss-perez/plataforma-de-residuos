# ============================================================
# EcoMatch - .gitignore
# ============================================================

# --- Secretos y variables de entorno (NUNCA commitear) ---
.env
.env.*
!.env.example

# --- Bases de datos locales y volúmenes ---
db-data/
*.sql
*.dump

# --- Node.js / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.vite/
*.tsbuildinfo

# --- Python / IA ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Java / Spring Boot ---
.mvn/
target/
*.class
*.jar
!mvnw
!mvnw.cmd
.gradle/
build/

# --- Docker ---
docker-compose.override.yml

# --- IDE y editores ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs y temporales ---
*.log
logs/
tmp/
temp/

# --- Cobertura de tests ---
coverage/
.nyc_output/
htmlcov/
.coverage

# --- Terraform (si se usa) ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# --- Archivos de configuración local ---
*.local
