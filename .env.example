# ============================================================
# EcoMatch - Template de variables de entorno
# COPIA este archivo a .env y rellena los valores reales.
# NUNCA commitear el archivo .env real.
# ============================================================

# --- Base de Datos ---
DB_PASSWORD=cambiar_esta_password_en_produccion
DB_NAME=ecmatch_db
DB_USER=root

# --- Backend API ---
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://db-ecmatch:3306/ecmatch_db?allowPublicKeyRetrieval=true&useSSL=false

# --- IA Orchestrator (GLM 5.2) ---
GLM_API_KEY=tu_api_key_de_glm_aqui
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://api.glm.example.com/v1
AI_PORT=8000

# --- Frontend ---
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8080
VITE_AI_CHAT_URL=http://localhost:8000

# --- Integraciones externas ---
MAPS_API_KEY=tu_api_key_de_mapas_aqui
SMTP_API_KEY=tu_api_key_de_sendgrid_aqui

# --- AWS (solo para deploy, no para local) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=353560240139
ECR_REGISTRY=353560240139.dkr.ecr.us-east-1.amazonaws.com
ECS_CLUSTER_NAME=cluster-ecmatch
ECS_SERVICE_NAME=servicio-ecmatch
