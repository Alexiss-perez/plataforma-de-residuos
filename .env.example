# ============================================================
# EcoMatch - Variables de entorno
# COPIA este archivo a .env y rellena los valores reales.
# NUNCA commitear el archivo .env real.
# ============================================================

# --- Base de Datos (PostgreSQL) ---
DB_USER=ecmatch
DB_PASSWORD=cambiar_esta_password_en_produccion
DB_NAME=ecmatch

# --- Backend (FastAPI) ---
JWT_SECRET=cambiar_esto_por_un_secret_seguro

# --- IA Orchestrator (GLM 5.2 via Kostra) ---
KOSTRA_API_KEY=tu_api_key_de_kostra_aqui

# --- Integraciones externas ---
MAPS_API_KEY=tu_api_key_de_mapas_aqui
SMTP_API_KEY=tu_api_key_de_sendgrid_aqui

# --- AWS (solo para deploy, no para local) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=353560240139
ECR_REGISTRY=353560240139.dkr.ecr.us-east-1.amazonaws.com
ECS_CLUSTER_NAME=cluster-ecmatch
ECS_SERVICE_NAME=servicio-ecmatch
